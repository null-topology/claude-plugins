{
  "mcpServers": {
    "op": {
      "command": "node",
      "args": ["${CLAUDE_PLUGIN_ROOT}/dist/server.js"],
      "env": {
        "OP_BRIDGE_IDLE_MINUTES": "${user_config.idle_window_minutes}",
        "OP_BRIDGE_ACCOUNTS": "${user_config.accounts}",
        "OP_BRIDGE_LANGUAGE": "${user_config.language}"
      }
    }
  }
}
